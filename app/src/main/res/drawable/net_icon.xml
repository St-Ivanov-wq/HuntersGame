    <!-- Diagonal Lines -->
    <path
        android:strokeColor="#4CAF50"
        android:strokeWidth="2"
        android:pathData="M30,30 L70,70" />

    <path
        android:strokeColor="#4CAF50"
        android:strokeWidth="2"
        android:pathData="M30,70 L70,30" />

    <!-- Center Knot (using path instead of circle) -->

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A2E">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingTop="40dp"
        android:background="#16213E">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DAILY CHALLENGES"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:gravity="center"/>
    </LinearLayout>

    <!-- Scrollable Challenges Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/challenges_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"/>
    </ScrollView>

    <!-- Bottom Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#16213E">

        <!-- Total Rewards -->
        <TextView
            android:id="@+id/tv_total_rewards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 XP available"
            android:textSize="16sp"
            android:textColor="#FFD700"
            android:gravity="center"
            android:layout_marginBottom="12dp"/>

        <!-- Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_reset_challenges"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="RESET"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#FF9800"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btn_claim_all"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="CLAIM ALL"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="#4CAF50"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Back Button -->
        <Button
            android:id="@+id/btn_back_challenges"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="BACK"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#E94560"
            android:layout_marginTop="12dp"/>
    </LinearLayout>

</LinearLayout>
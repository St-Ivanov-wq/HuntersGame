<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A3F2C">

    <!-- Enhanced Fiery Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:paddingTop="56dp"
        android:background="#B22222">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚔️ DAILY CHALLENGES"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textColor="#FFD700"
            android:shadowColor="#8B0000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:letterSpacing="0.5"
            android:gravity="center"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Complete quests to earn legendary XP!"
            android:textSize="16sp"
            android:textColor="#FFEBEE"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"/>
    </LinearLayout>

    <!-- Premium ScrollView with Shadow -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/challenges_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="28dp"
            android:paddingBottom="160dp"/>
    </androidx.core.widget.NestedScrollView>

    <!-- Epic Red/Gold Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:background="#8B0000">

        <!-- Rewards with Icon & Glow -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFD70020"
            android:padding="16dp"
            android:layout_marginBottom="24dp"
            android:clipToPadding="false">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔥"
                android:textSize="28sp"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/tv_total_rewards"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="450 XP available to claim"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFD700"
                android:shadowColor="#FF0000"
                android:shadowRadius="4"/>
        </LinearLayout>

        <!-- Enhanced Button Stack -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset_challenges"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginBottom="16dp"
            android:text="RESET CHALLENGES"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#FF5722"
            app:icon="@android:drawable/ic_menu_rotate"
            app:iconTint="#FFD700"
            app:iconGravity="start"
            app:iconPadding="16dp"
            app:iconSize="24dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_claim_all"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginBottom="20dp"
            android:text="CLAIM ALL REWARDS"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#FF4500"
            app:strokeColor="#FFD700"
            app:strokeWidth="2dp"
            app:icon="@android:drawable/ic_menu_save"
            app:iconTint="#FFFFFF"
            app:iconGravity="start"
            app:iconPadding="16dp"
            app:iconSize="24dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back_challenges"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="← BACK TO MENU"
            android:textSize="18sp"
            android:textStyle="bold"
            app:backgroundTint="#E94560"
            app:strokeColor="#FFD700"
            app:strokeWidth="2dp"
            app:icon="@android:drawable/ic_menu_revert"
            app:iconTint="#FFD700"
            app:iconGravity="start"
            app:iconPadding="16dp"
            app:iconSize="24dp"/>
    </LinearLayout>

</LinearLayout>
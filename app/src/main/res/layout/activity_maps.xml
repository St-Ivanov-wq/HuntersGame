<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#00000000">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFD700"
            android:padding="16dp"
            android:elevation="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HUNTING MAP"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1A3F2C"
                android:shadowColor="#FFFFFF"
                android:shadowRadius="2"/>

            <TextView
                android:id="@+id/tv_xp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐ LVL 1 (0/100)"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A3F2C"
                android:paddingStart="16dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_map_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Locating mythical creatures..."
            android:textSize="16sp"
            android:textColor="#FFD700"
            android:padding="20dp"
            android:background="#1A3F2C"
            android:gravity="center"
            android:elevation="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="20dp"
            android:background="#FFFFFF"
            android:elevation="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_find_nearby"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="SCAN AREA"
                android:textSize="18sp"
                android:textColor="#1A3F2C"
                app:backgroundTint="#FFD700"
                android:layout_marginEnd="16dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back_maps"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="← BACK TO MENU"
                android:textSize="13sp"
                app:backgroundTint="#FFFFFF"
                app:strokeColor="#1A3F2C"
                android:textColor="#1A3F2C"
                android:layout_marginStart="16dp"/>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Camera Preview -->
    <SurfaceView
        android:id="@+id/surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Dark Green Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA1A3A2A" />

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical">

        <!-- Bulgarian Flag Stripes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:background="#FFFFFF"/>
            <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:background="#00966E"/>
            <View android:layout_width="0dp" android:layout_height="4dp" android:layout_weight="1" android:background="#D62612"/>
        </LinearLayout>

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#CC1A3A2A"
            android:padding="16dp"
            android:paddingTop="20dp">

            <TextView
                android:id="@+id/tv_creature_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Vila"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFD700"/>

            <TextView
                android:id="@+id/tv_creature_points"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="110 XP"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="#D62612"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Combo Display -->
    <TextView
        android:id="@+id/tv_combo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="120dp"
        android:text="COMBO x3"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FFA500"
        android:visibility="gone"
        android:padding="8dp"
        android:background="#D62612"/>

    <!-- Creature Sprite Container -->
    <FrameLayout
        android:id="@+id/sprite_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <ImageView
            android:id="@+id/creature_sprite"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:layout_marginTop="80dp"
            android:visibility="visible"
            android:scaleType="fitCenter"/>
    </FrameLayout>

    <!-- Net Image -->
    <ImageView
        android:id="@+id/net_image"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/net_icon"
        android:visibility="gone"
        android:scaleType="fitCenter"/>

    <!-- Bottom Panel -->
    <LinearLayout
        android:id="@+id/bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:background="#CC1A3A2A"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_ar_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Get close to the creature"
            android:textSize="13sp"
            android:textColor="#FFD700"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- Power Meter -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="THROW POWER"
                    android:textSize="11sp"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/power_meter_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textSize="16sp"
                    android:textColor="#FFD700"
                    android:textStyle="bold"/>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:background="#333333">

                <View
                    android:id="@+id/power_bar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#D62612"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WEAK"
                    android:textSize="9sp"
                    android:textColor="#D62612"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="OPTIMAL"
                    android:textSize="9sp"
                    android:textColor="#4CAF50"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="OVER"
                    android:textSize="9sp"
                    android:textColor="#D62612"
                    android:gravity="end"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_throw"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="THROW"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#D62612"
                android:layout_marginEnd="12dp"/>

            <Button
                android:id="@+id/btn_ar_back"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="BACK"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#2A5A3A"
                android:layout_marginStart="12dp"/>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
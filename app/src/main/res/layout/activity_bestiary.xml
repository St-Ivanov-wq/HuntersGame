<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bulgarian_forest_gradient">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingTop="48dp"
        android:background="#1A3F2C">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BESTIARY"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textColor="#FFD700"
            android:shadowColor="#8B0000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:letterSpacing="0.5"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tv_total_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 / 0 CAPTURED"
            android:textSize="14sp"
            android:textColor="#D4AF37"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.5"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_empty_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hunt some creatures first!"
        android:textSize="14sp"
        android:textColor="#A8A8A8"
        android:gravity="center"
        android:padding="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:visibility="gone"
        android:lineSpacingExtra="0dp"
        android:minHeight="0dp" />

    <!-- Scrollable Creature Cards -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/creatures_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="100dp"/>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_back_bestiary"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="← BACK TO MENU"
        android:textSize="18sp"
        android:textStyle="bold"
        app:backgroundTint="#E94560"
        app:strokeColor="#FFD700"
        app:strokeWidth="2dp"
        app:icon="@android:drawable/ic_menu_revert"
        app:iconTint="#FFD700"
        app:iconGravity="start"
        app:iconPadding="16dp"
        android:layout_margin="20dp"
        app:iconSize="24dp"/>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A2E">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingTop="40dp"
        android:background="#16213E">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BESTIARY"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:letterSpacing="1"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tv_total_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 / 0 CAPTURED"
            android:textSize="12sp"
            android:textColor="#CCCCCC"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:letterSpacing="1"/>
    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/tv_empty_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No creatures captured yet.\nGo hunting!"
        android:textSize="16sp"
        android:textColor="#666666"
        android:gravity="center"
        android:padding="40dp"
        android:visibility="gone"/>

    <!-- Scrollable Creature List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/creatures_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"/>
    </ScrollView>

    <!-- Back Button -->
    <Button
        android:id="@+id/btn_back_bestiary"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="BACK"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#E94560"
        android:letterSpacing="2"
        android:layout_margin="16dp"/>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#1A1A2E"
    android:padding="24dp"
    android:elevation="8dp"
    android:gravity="center">

    <!-- Creature Image -->
    <ImageView
        android:id="@+id/dialog_creature_sprite"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center"
        android:scaleType="fitCenter"
        android:contentDescription="Creature Image"/>

    <!-- Title Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/dialog_creature_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Creature Name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:gravity="center"/>

        <TextView
            android:id="@+id/dialog_creature_name_bulgarian"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Българско име"
            android:textSize="16sp"
            android:textColor="#CCCCCC"
            android:gravity="center"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginBottom="16dp"/>

    <!-- Capture Info (Rank and count) -->
    <TextView
        android:id="@+id/dialog_capture_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Novice Hunter • 1 capture"
        android:textSize="12sp"
        android:textColor="#888888"
        android:gravity="center"
        android:layout_marginBottom="12dp"/>

    <!-- Description -->
    <TextView
        android:id="@+id/dialog_creature_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Description"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="12dp"/>

    <!-- Habitat -->
    <TextView
        android:id="@+id/dialog_creature_habitat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Habitat: Forest"
        android:textSize="13sp"
        android:textColor="#888888"
        android:layout_marginBottom="8dp"/>

    <!-- XP Points -->
    <TextView
        android:id="@+id/dialog_creature_points"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="XP Value: 100"
        android:textSize="13sp"
        android:textColor="#FFD700"
        android:layout_marginBottom="20dp"/>

    <TextView
        android:id="@+id/dialog_rank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NOVICE HUNTER"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#666666"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <!-- Close Button -->
    <Button
        android:id="@+id/btn_close_dialog"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="CLOSE"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#E94560"
        android:letterSpacing="1.5"/>

</LinearLayout>
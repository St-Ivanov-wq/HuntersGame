<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bulgarian_forest_gradient"
    android:padding="28dp"
    android:elevation="12dp"
    android:clipToPadding="false">

    <!-- Creature Image with Glow -->
    <ImageView
        android:id="@+id/dialog_creature_sprite"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center"
        android:scaleType="centerCrop"
        android:background="#FFD70020"
        android:padding="12dp"
        android:elevation="8dp"
        android:contentDescription="Creature sprite"/>

    <!-- Title Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/dialog_creature_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ZMEY"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textColor="#FFD700"
            android:shadowColor="#8B0000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:gravity="center"/>

        <TextView
            android:id="@+id/dialog_creature_name_bulgarian"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Змей"
            android:textSize="18sp"
            android:textColor="#D4AF37"
            android:fontFamily="serif"
            android:gravity="center"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <TextView
        android:id="@+id/dialog_master_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⭐ FULLY MASTERED ⭐"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFD700"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <!-- Gold Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#D4AF37"
        android:elevation="2dp"
        android:layout_marginBottom="20dp"/>

    <!-- Capture Info -->
    <TextView
        android:id="@+id/dialog_capture_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🧙‍♂️ Novice Hunter • 1 capture"
        android:textSize="14sp"
        android:textColor="#CCCCCC"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <!-- Description -->
    <TextView
        android:id="@+id/dialog_creature_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fire-breathing dragon from Bulgarian mountains. Guardians of treasures and fierce warriors."
        android:textSize="15sp"
        android:textColor="#E8E8E8"
        android:lineSpacingExtra="6dp"
        android:layout_marginBottom="16dp"/>

    <!-- Habitat & XP Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/dialog_creature_habitat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🏔️ Mountains"
            android:textSize="14sp"
            android:textColor="#CCCCCC"
            android:gravity="center"/>

        <TextView
            android:id="@+id/dialog_creature_points"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ 150 XP"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFD700"
            android:gravity="center"/>
    </LinearLayout>

    <TextView
        android:id="@+id/dialog_rank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NOVICE HUNTER"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#D4AF37"
        android:gravity="center"
        android:layout_marginBottom="20dp"/>



    <!-- Close Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_close_dialog"
        style="@style/Widget.Material3.Button.ElevatedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="CLOSE"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#E94560"
        app:strokeColor="#FFD700"
        app:strokeWidth="1dp"
        android:textColor="#FFFFFF"
        android:letterSpacing="0.1"/>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#2C3E2B"
    android:padding="16dp">

    <!-- Header with points -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#4CAF50"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HUNTING MODE"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"/>

        <TextView
            android:id="@+id/tv_points"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⭐ Points: 0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFD700"/>
    </LinearLayout>

    <!-- Location Status -->
    <TextView
        android:id="@+id/tv_location_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📍 Press 'Find Creatures' to start hunting!"
        android:textSize="14sp"
        android:textColor="#CCCCCC"
        android:padding="12dp"
        android:background="#3E5A3D"
        android:layout_marginBottom="16dp"/>

    <!-- Creature Information Card - Using LinearLayout instead of CardView -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:background="#F5F5DC"
        android:padding="16dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tv_creature_found"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔍 Search for mythical creatures in your area!\n\nUse your real-world location to discover and capture Bulgarian folklore creatures."
                android:textSize="16sp"
                android:textColor="#2C3E2B"
                android:lineSpacingExtra="4dp"/>
        </ScrollView>
    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp">

        <Button
            android:id="@+id/btn_find_creatures"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔍 Find Creatures"
            android:textSize="16sp"
            android:backgroundTint="#2196F3"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btn_capture"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="✨ Capture!"
            android:textSize="16sp"
            android:backgroundTint="#4CAF50"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/btn_back"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="← Back to Menu"
        android:textSize="14sp"
        android:backgroundTint="#FF9800"
        android:layout_marginTop="8dp"/>

</LinearLayout>